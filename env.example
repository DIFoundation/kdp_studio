# ── Supabase ──────────────────────────────────────────────
# Get these from https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI Text Providers (configure any subset) ──────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── AI Image Providers (configure any subset) ─────────────
# OpenAI images (DALL·E / gpt-image) uses OPENAI_API_KEY above.
STABILITY_API_KEY=
REPLICATE_API_TOKEN=

# ── Provider selection ────────────────────────────────────
# Comma-separated fallback order for text generation.
# Available: openai, anthropic, google
AI_TEXT_PROVIDERS=openai,anthropic,google
# Comma-separated fallback order for image generation.
# Available: openai, stability, replicate
AI_IMAGE_PROVIDERS=openai,stability,replicate

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
